---
import Icon from '../Icon.astro';
import { reviews, site } from '../../data/site';

const videoLinks = [
  { label: 'YouTube', href: site.social.youtube },
  { label: 'Instagram', href: site.social.instagram },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
---
<section class="section section--soft" id="reviews">
  <div class="container">
    <div class="reviews__head">
      <div class="section-head">
        <span class="eyebrow">Reviews</span>
        <h2>They were scared too. <mark>Now they ride.</mark></h2>
      </div>
      <a class="rating card" href={site.googleReviewsUrl} target="_blank" rel="noopener">
        <strong>4.9</strong>
        <span>
          <span class="rating__stars" aria-hidden="true">★★★★★</span>
          <span>300+ Google reviews</span>
        </span>
        <Icon name="arrow" />
      </a>
    </div>

    <ul class="reviews" data-reviews>
      {reviews.map((r) => (
        <li class="review card">
          <span class="review__stars" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</span>
          <blockquote>“{r.quote}”</blockquote>
          <div class="review__person">
            <span class="review__avatar" aria-hidden="true">{r.name.charAt(0)}</span>
            <span><strong>{r.name}</strong><small>{r.meta}</small></span>
          </div>
        </li>
      ))}
    </ul>

    {videoLinks.length > 0 && (
      <p class="reviews__more">
        Watch real classes on{' '}
        {videoLinks.map((l, i) => (
          <>{i > 0 && ' and '}<a href={l.href} target="_blank" rel="noopener">{l.label}</a></>
        ))}.
      </p>
    )}
  </div>
</section>

<script>
  import { fetchTable } from '../../scripts/supabase';

  type ReviewRow = { name?: string; meta?: string; location?: string; review_text?: string; quote?: string; rating?: number };

  const list = document.querySelector<HTMLUListElement>('[data-reviews]');

  // Built with DOM APIs (textContent), never innerHTML, so database text can't inject markup.
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  fetchTable<ReviewRow>('learner_reviews', 'select=*&active=eq.true&order=sort_order.asc&limit=6').then((rows) => {
    const valid = rows.filter((r) => r.name && (r.review_text || r.quote));
    if (!list || !valid.length) return;
    list.replaceChildren(
      ...valid.map((r) => {
        const rating = Math.max(1, Math.min(5, Number(r.rating) || 5));
        const li = el('li', 'review card');
        const stars = el('span', 'review__stars', '★'.repeat(rating));
        stars.setAttribute('aria-label', `${rating} out of 5 stars`);
        const person = el('div', 'review__person');
        const avatar = el('span', 'review__avatar', r.name!.charAt(0).toUpperCase());
        avatar.setAttribute('aria-hidden', 'true');
        const who = el('span');
        who.append(el('strong', undefined, r.name), el('small', undefined, r.meta || r.location || 'Zero Fear learner'));
        person.append(avatar, who);
        li.append(stars, el('blockquote', undefined, `“${r.review_text || r.quote}”`), person);
        return li;
      }),
    );
  });

</script>

<style>
  .reviews__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(32px, 5vw, 48px); }
  .reviews__head .section-head { margin-bottom: 0; }
  .rating { display: flex; align-items: center; gap: 14px; padding: 14px 20px; text-decoration: none; }
  .rating:hover { border-color: var(--navy); }
  .rating > strong { font-size: 2rem; font-weight: 800; color: var(--navy); }
  .rating > span { display: grid; font-size: 0.85rem; color: var(--muted); }
  .rating__stars { color: #f5a500; letter-spacing: 2px; }
  .rating :global(svg) { width: 18px; height: 18px; }

  .reviews { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  :global(.review) { padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  :global(.review__stars) { color: #f5a500; letter-spacing: 2px; }
  :global(.review blockquote) { margin: 0; font-size: 1.02rem; line-height: 1.6; flex: 1; }
  :global(.review__person) { display: flex; align-items: center; gap: 12px; }
  :global(.review__person > span:last-child) { display: grid; line-height: 1.3; }
  :global(.review__person small) { color: var(--muted); font-size: 0.85rem; }
  :global(.review__avatar) { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--navy); color: #fff; font-weight: 700; }


  .reviews__more { margin-top: 32px; text-align: center; color: var(--muted); }
  .reviews__more a { color: var(--blue); font-weight: 600; }

  @media (max-width: 900px) {
    .reviews { grid-template-columns: 1fr; }
  }
</style>
