---
import { gallery } from '../../data/site';
const photos = gallery.slice(0, 7);
---
<section class="section gallery-sec" aria-labelledby="gallery-title">
  <div class="container">
    <div class="head" data-reveal>
      <span class="eyebrow">Training in action</span>
      <h2 id="gallery-title">Real classes. <mark>Real learners.</mark></h2>
    </div>
    <ul class="bento">
      {photos.map((p, i) => (
        <li class={`b b${i}`} data-reveal style={`transition-delay:${i * 60}ms`}>
          <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { margin-bottom: clamp(28px, 4vw, 48px); }
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 220px; grid-auto-flow: dense; gap: 12px; }
  .b { border-radius: var(--radius); overflow: hidden; background: var(--border); }
  .b img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
  .b:hover img { transform: scale(1.05); }
  .b0 { grid-column: span 2; grid-row: span 2; }
  .b3 { grid-row: span 2; }
  .b6 { grid-column: span 2; }
  @media (max-width: 760px) {
    .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 150px; gap: 8px; }
    .b0 { grid-column: span 2; grid-row: span 2; }
    .b3 { grid-row: span 1; }
    .b6 { grid-column: span 2; }
  }
</style>
