---
import { gallery } from '../../data/site';
---
<section class="strip" aria-label="Photos from our classes">
  <ul class="strip__list">
    {gallery.map((p) => (
      <li><img src={p.src} alt={p.alt} loading="lazy" decoding="async" width="800" height="800" /></li>
    ))}
  </ul>
</section>

<style>
  .strip { padding-block: 14px; background: var(--navy); }
  .strip__list {
    list-style: none; margin: 0; padding: 0 14px;
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(180px, 22vw, 300px); gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .strip__list::-webkit-scrollbar { display: none; }
  .strip__list li { aspect-ratio: 1; border-radius: 14px; overflow: hidden; scroll-snap-align: start; background: var(--navy-2); }
  .strip__list img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 1400px) {
    .strip__list { grid-auto-flow: row; grid-template-columns: repeat(8, 1fr); grid-auto-columns: auto; overflow: visible; }
  }
</style>
