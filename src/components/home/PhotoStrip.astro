---
import Icon from '../Icon.astro';
import CmsImg from '../CmsImg.astro';
import { text as t, trainingGallery } from '../../cms';
const photos = trainingGallery.slice(0, 7);
---
<section class="section gallery-sec" aria-labelledby="gallery-title">
  <div class="container">
    <div class="head" data-reveal>
      <div>
        <span class="eyebrow" set:html={t('gallery.eyebrow').html} />
        <h2 id="gallery-title" set:html={t('gallery.title').html} />
      </div>
      <a class="btn btn--dark" href="/gallery">{t('gallery.button').plain} <Icon name="arrow" /></a>
    </div>
    <ul class="bento">
      {photos.map((p, i) => (
        <li class={`b b${i}`} data-reveal style={`transition-delay:${i * 60}ms`}>
          <a href={`/gallery#photo-${i + 1}`}><CmsImg photo={p} sizes="(max-width: 760px) 50vw, 25vw" /></a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 48px); }
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 220px; grid-auto-flow: dense; gap: 12px; }
  .b { border-radius: var(--radius); overflow: hidden; background: var(--border); }
  .b a { display: block; width: 100%; height: 100%; }
  .b :global(img) { transition: transform 0.6s; }
  .b:hover :global(img) { transform: scale(1.05); }
  .b0 { grid-column: span 2; grid-row: span 2; }
  .b4 { grid-row: span 2; }
  .b6 { grid-column: span 2; }
  @media (max-width: 760px) {
    .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 150px; gap: 8px; }
    .b0 { grid-column: span 2; grid-row: span 2; }
    .b4 { grid-row: span 2; }
    .b6 { grid-column: span 2; }
  }
</style>
