---
import Photo from '../Photo.astro';
import { steps, photos } from '../../data/site';
---
<section class="section section--navy" id="how-it-works">
  <div class="container">
    <div class="how__intro">
      <div class="section-head">
        <span class="eyebrow">Why Zero Fear</span>
        <h2>Built around <mark>the learner.</mark></h2>
        <p>No fixed formula. Your trainer starts from where you are and moves on only when you’re ready.</p>
      </div>
      <div class="how__photo">
        <Photo src={photos.howItWorks.src} alt={photos.howItWorks.alt} position={photos.howItWorks.position} />
      </div>
    </div>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how__intro { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: center; margin-bottom: clamp(32px, 5vw, 48px); }
  .how__intro .section-head { margin-bottom: 0; }
  .how__photo { aspect-ratio: 3 / 2; border-radius: var(--radius); overflow: hidden; }
  @media (max-width: 860px) { .how__intro { grid-template-columns: 1fr; } }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: none; }
  .step { padding: 24px; border-radius: var(--radius); background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); }
  .step__num {
    display: block; font-family: var(--font-display); font-weight: 800; font-size: 3rem; line-height: 1;
    color: var(--yellow); letter-spacing: -0.04em;
  }
  .step h3 { margin-top: 18px; color: #fff; }
  .step p { margin-top: 8px; color: #c5d2e6; font-size: 0.95rem; }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .steps { gap: 10px; }
    .step { padding: 16px; }
    .step__num { font-size: 2.2rem; }
    .step h3 { margin-top: 10px; font-size: 1.05rem; }
    .step p { font-size: 0.85rem; }
  }
</style>
