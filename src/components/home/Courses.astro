---
import CourseCard from '../CourseCard.astro';
import Icon from '../Icon.astro';
import { courses, formatINR } from '../../data/site';

// `heading={false}` renders the plain card grid (used on /courses).
interface Props { heading?: boolean }
const { heading = true } = Astro.props;
---
{heading ? (
  <section class="section dark courses-home" id="courses">
    <div class="container">
      <div class="head" data-reveal>
        <div>
          <span class="eyebrow">Courses</span>
          <h2>Pick your <mark>starting point.</mark></h2>
        </div>
        <a class="btn btn--glass" href="/courses">All courses <Icon name="arrow" /></a>
      </div>

      <div class="bento">
        {courses.map((c, i) => (
          <a class:list={['tile', `tile--${i}`]} href={`/courses/${c.slug}`} data-reveal style={`transition-delay:${i * 80}ms`}>
            <img src={c.photo.src} alt={c.photo.alt} loading="lazy" decoding="async" style={`object-position:${c.photo.position ?? '50% 35%'}`} />
            <span class="tile__num">0{i + 1}</span>
            <span class="tile__level">{c.level}</span>
            <div class="tile__body">
              <h3>{c.name}</h3>
              <p>{c.summary}</p>
              <div class="tile__meta">
                <span>{c.classes}</span>
                {c.price !== null && <strong>From {formatINR(c.price)}</strong>}
              </div>
            </div>
            <span class="tile__go" aria-hidden="true"><Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
) : (
  <section class="section" id="courses">
    <div class="container">
      <div class="courses">
        {courses.map((c) => <CourseCard course={c} />)}
      </div>
    </div>
  </section>
)}

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(32px, 5vw, 56px); }

  .bento { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: 300px; gap: 14px; }
  .tile--0 { grid-column: span 7; grid-row: span 2; }
  .tile--1 { grid-column: span 5; }
  .tile--2 { grid-column: span 5; }
  .tile--3 { grid-column: span 12; grid-row: span 1; }

  .tile {
    position: relative; isolation: isolate; overflow: hidden; border-radius: var(--radius-lg);
    display: flex; flex-direction: column; justify-content: flex-end; padding: 24px;
    color: #fff; text-decoration: none; background: var(--navy-2);
  }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
  .tile::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(12,15,22,0.05) 30%, rgba(12,15,22,0.88) 100%); }
  .tile:hover img { transform: scale(1.05); }

  .tile__num { position: absolute; top: 18px; right: 22px; font-family: var(--font-display); font-size: 1.4rem; color: rgba(255,255,255,0.8); }
  .tile__level { position: absolute; top: 18px; left: 18px; padding: 6px 12px; border-radius: 999px; background: var(--yellow); color: var(--navy); font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; }
  .tile h3 { font-family: var(--font-display); font-weight: 400; text-transform: uppercase; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 0.95; }
  .tile--0 h3 { font-size: clamp(2.4rem, 4.6vw, 4rem); }
  .tile p { margin-top: 10px; color: #d2d6de; max-width: 40ch; font-size: 0.95rem; }
  .tile__meta { margin-top: 14px; display: flex; gap: 14px; align-items: center; font-size: 0.85rem; color: #aab0bc; }
  .tile__meta strong { color: var(--yellow); font-size: 1rem; }
  .tile__go {
    position: absolute; right: 20px; bottom: 20px; width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; background: #fff; color: var(--navy); transition: transform 0.2s, background 0.2s;
  }
  .tile__go :global(svg) { width: 20px; height: 20px; transform: rotate(-45deg); transition: transform 0.2s; }
  .tile:hover .tile__go { background: var(--yellow); }
  .tile:hover .tile__go :global(svg) { transform: rotate(0); }

  .courses { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  @media (max-width: 1080px) { .courses { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .courses { grid-template-columns: 1fr; } }

  @media (max-width: 860px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: 360px; }
    .tile--0, .tile--1, .tile--2, .tile--3 { grid-column: auto; grid-row: auto; }
    .tile--0 h3 { font-size: 2.4rem; }
    .tile { padding-right: 80px; }
  }
</style>
