---
import { journey } from '../../data/site';
---
<section class="section section--navy journey" id="journey">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Our trainers’ journey</span>
      <h2>8 years of teaching. <mark>Now Zero Fear.</mark></h2>
      <p>Shaped by thousands of learners and one belief: riding can create independence.</p>
    </div>
    <ol class="journey__list">
      {journey.map((j) => (
        <li data-reveal>
          <span class="journey__year">{j.year}</span>
          <h3>{j.title}</h3>
          <p>{j.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .journey__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; position: relative; }
  .journey__list::before { content: ''; position: absolute; left: 0; right: 0; top: 40px; height: 2px; background: rgba(255, 255, 255, 0.18); }
  .journey__list li { position: relative; padding-top: 0; }
  .journey__year {
    display: inline-block; position: relative; padding-right: 14px; background: var(--navy);
    font-family: var(--font-display); font-weight: 400; font-size: clamp(3.4rem, 6vw, 5rem); line-height: 1;
    color: var(--yellow); letter-spacing: -0.04em;
  }
  .journey__list li:last-child .journey__year { color: #fff; }
  .journey__list h3 { margin-top: 14px; }
  .journey__list p { margin-top: 8px; color: #c5d2e6; font-size: 0.95rem; }
  @media (max-width: 860px) {
    .journey__list { grid-template-columns: 1fr; gap: 28px; padding-left: 22px; }
    .journey__list::before { left: 4px; right: auto; top: 10px; bottom: 10px; width: 2px; height: auto; }
    .journey__list li::before { content: ''; position: absolute; left: -24px; top: 18px; width: 12px; height: 12px; border-radius: 50%; background: var(--yellow); }
    .journey__year { padding-right: 0; }
  }
</style>
