---
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import { site, photos, courses, formatINR, waLink } from '../../data/site';
const prices = courses.map((c) => c.price).filter((p): p is number => p !== null);
const fromPrice = prices.length ? Math.min(...prices) : null;
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__place"><Icon name="pin" /> {site.area}, {site.city}</p>
      <h1>Scooty & bike training in Kolkata. <span>Even if you can’t ride a cycle.</span></h1>
      <p class="hero__lead">
        One-to-one classes for complete beginners. Learn at our practice area near Netaji Metro, or at your doorstep within 10 km.
      </p>

      <ul class="hero__points">
        <li><Icon name="check" /> No cycling needed</li>
        <li><Icon name="check" /> Patient, trainer-led classes</li>
        <li><Icon name="check" /> Practice ground → real roads</li>
      </ul>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">Book a class <Icon name="arrow" /></a>
        <a class="btn btn--whatsapp" href={waLink('Hi Zero Fear, I want to learn to ride.')} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
      </div>
      {fromPrice && <p class="hero__price">Courses from <strong>{formatINR(fromPrice)}</strong></p>}
    </div>

    <div class="hero__media">
      <Photo src={photos.hero.src} alt={photos.hero.alt} eager />
      <div class="hero__badge card">
        <span class="hero__stars" aria-hidden="true">★★★★★</span>
        <strong>4.9 on Google</strong>
        <span>300+ learner reviews</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(48px, 7vw, 96px); }
  .hero__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 72px); align-items: center; }

  .hero__place {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.9rem; font-weight: 600; color: var(--muted); margin-bottom: 18px;
  }
  .hero__place :global(svg) { width: 16px; height: 16px; color: var(--blue); }
  h1 span { color: var(--blue); }
  .hero__lead { margin-top: 20px; font-size: 1.15rem; color: var(--muted); max-width: 52ch; }

  .hero__points { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 10px 20px; }
  .hero__points li { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.95rem; }
  .hero__points :global(svg) { width: 18px; height: 18px; color: var(--success); }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__price { margin-top: 16px; color: var(--muted); font-size: 0.95rem; }
  .hero__price strong { color: var(--navy); }

  .hero__media { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); }
  .hero__media > :global(.photo) { border-radius: var(--radius-lg); }
  .hero__badge {
    position: absolute; left: -20px; bottom: 28px;
    display: grid; gap: 2px; padding: 14px 18px;
    box-shadow: var(--shadow);
  }
  .hero__stars { color: #f5a500; letter-spacing: 2px; font-size: 0.9rem; }
  .hero__badge strong { font-size: 1rem; }
  .hero__badge span:last-child { font-size: 0.85rem; color: var(--muted); }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { aspect-ratio: 16 / 10; }
    .hero__badge { left: 12px; bottom: 12px; }
  }
  @media (max-width: 480px) {
    .hero__actions .btn { flex: 1 1 100%; }
  }
</style>
