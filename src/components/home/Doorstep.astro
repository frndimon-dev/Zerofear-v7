---
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import FeeCalculator from '../FeeCalculator.astro';
import { doorstep, photos } from '../../data/site';
---
<section class="section" id="doorstep">
  <div class="container doorstep">
    <div class="doorstep__copy">
      <span class="eyebrow">Doorstep training</span>
      <h2>Your lane. Your scooty. <mark>Your trainer.</mark></h2>
      <p class="doorstep__lead">
        Learn near your home, on your own scooty if you like. Available within {doorstep.radiusKm} km of {doorstep.from}.
      </p>
      <p class="doorstep__areas-label">Areas we often cover</p>
      <ul class="doorstep__areas">
        {doorstep.areas.map((a) => <li class="chip">{a}</li>)}
        <li class="chip">and more</li>
      </ul>
      <a class="doorstep__more" href="/doorstep-training">How doorstep training works <Icon name="arrow" /></a>
      <div class="doorstep__media"><Photo src={photos.doorstep.src} alt={photos.doorstep.alt} position={photos.doorstep.position} /></div>
    </div>

    <div class="doorstep__calc"><FeeCalculator /></div>
  </div>
</section>

<style>
  .doorstep { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .doorstep__lead { margin-top: 14px; color: var(--muted); font-size: 1.075rem; max-width: 52ch; }
  .doorstep__areas-label { margin-top: 24px; font-weight: 700; font-size: 0.9rem; }
  .doorstep__areas { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .doorstep__more { display: inline-flex; align-items: center; gap: 6px; margin-top: 20px; font-weight: 700; color: var(--blue); text-decoration: none; }
  .doorstep__more :global(svg) { width: 16px; height: 16px; }
  .doorstep__media { margin-top: 28px; aspect-ratio: 5 / 4; border-radius: var(--radius); overflow: hidden; }
  .doorstep__calc { position: sticky; top: calc(var(--header-h) + 20px); }

  @media (max-width: 900px) {
    .doorstep { grid-template-columns: 1fr; }
    .doorstep__calc { position: static; }
  }
</style>
