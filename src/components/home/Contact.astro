---
import Icon from '../Icon.astro';
import { site, courses, waLink } from '../../data/site';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
---
<section class="section section--soft" id="contact">
  <div class="container contact">
    <div class="contact__info">
      <span class="eyebrow">Contact</span>
      <h2>Book your first class.</h2>
      <p class="contact__lead">Tell us what you want to learn and when you’re free. We’ll call you back to fix a slot.</p>

      <ul class="contact__list">
        <li>
          <Icon name="phone" />
          <span><small>Call</small><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></span>
        </li>
        <li>
          <Icon name="whatsapp" />
          <span><small>WhatsApp</small><a href={waLink('Hi Zero Fear')} target="_blank" rel="noopener">{site.whatsapp.display}</a></span>
        </li>
        <li>
          <Icon name="pin" />
          <span><small>Where</small>{site.address ?? `${site.area}, ${site.city}`}</span>
        </li>
        {site.hours && (
          <li>
            <Icon name="clock" />
            <span><small>Hours</small>{site.hours}</span>
          </li>
        )}
      </ul>

      <div class="contact__map">
        <iframe src={mapSrc} title="Zero Fear location map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>

    <form class="form card" data-contact-form>
      <h3>Send an enquiry</h3>
      <label>
        <span>Your name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        <span>Phone number</span>
        <input name="phone" type="tel" inputmode="tel" autocomplete="tel" pattern="[0-9+ ]{10,14}" required />
      </label>
      <label>
        <span>What do you want to learn?</span>
        <select name="course" required>
          {courses.map((c) => <option>{c.name}</option>)}
          <option>Doorstep Training</option>
          <option>Not sure yet</option>
        </select>
      </label>
      <label>
        <span>Your area & preferred time <em>(optional)</em></span>
        <textarea name="message" rows="3"></textarea>
      </label>
      <button class="btn btn--primary btn--block" type="submit"><Icon name="whatsapp" /> Send on WhatsApp</button>
      <p class="form__note">This opens WhatsApp with your details filled in.</p>
    </form>
  </div>
</section>

<script define:vars={{ waNumber: site.whatsapp.number }}>
  const form = document.querySelector('[data-contact-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const lines = [
      'Hi Zero Fear, I want to book a class.',
      `Name: ${d.get('name')}`,
      `Phone: ${d.get('phone')}`,
      `Course: ${d.get('course')}`,
    ];
    if (String(d.get('message') || '').trim()) lines.push(`Area / time: ${d.get('message')}`);
    window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .contact__lead { margin-top: 14px; color: var(--muted); font-size: 1.075rem; }
  .contact__list { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 18px; }
  .contact__list li { display: flex; gap: 14px; align-items: flex-start; }
  .contact__list :global(svg) { width: 20px; height: 20px; margin-top: 3px; color: var(--blue); flex: none; }
  .contact__list span { display: grid; font-weight: 600; }
  .contact__list small { font-size: 0.8rem; color: var(--muted); font-weight: 500; }
  .contact__list a { text-decoration: none; font-size: 1.1rem; }
  .contact__list a:hover { color: var(--blue); }
  .contact__map { margin-top: 28px; aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); background: var(--border); }
  .contact__map iframe { width: 100%; height: 100%; border: 0; }

  .form { padding: 28px; display: grid; gap: 16px; box-shadow: var(--shadow); }
  .form label { display: grid; gap: 6px; font-weight: 600; font-size: 0.92rem; }
  .form em { font-style: normal; color: var(--muted); font-weight: 500; }
  .form input, .form select, .form textarea {
    width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: #fff; font-size: 1rem; font-weight: 500;
  }
  .form input:focus, .form select:focus, .form textarea:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(20, 87, 217, 0.15); }
  .form__note { font-size: 0.82rem; color: var(--muted); text-align: center; }

  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
</style>
