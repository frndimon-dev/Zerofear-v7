---
import Icon from '../Icon.astro';
import { site } from '../../data/site';
---
<section class="section statement">
  <div class="container statement__grid">
    <div data-reveal>
      <span class="eyebrow">About Zero Fear</span>
      <p class="statement__text">
        We teach complete beginners, even people who never rode a cycle, to ride Kolkata roads <em>on their own.</em>
      </p>
    </div>
    <div class="statement__side" data-reveal>
      <p>Patient trainers, one learner at a time. Practice ground first, real traffic only when you’re ready.</p>
      <a class="btn btn--dark btn--lg" href="/about">Our story <Icon name="arrow" /></a>
    </div>
  </div>

  <div class="container">
    <ul class="stats">
      {site.stats.map((s, i) => (
        <li data-reveal style={`transition-delay:${i * 90}ms`}><strong>{s.value}</strong><span>{s.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .statement__grid { display: grid; grid-template-columns: 1.35fr 0.65fr; gap: clamp(28px, 6vw, 80px); align-items: end; }
  .statement__text {
    font-family: var(--font); font-weight: 700; color: var(--navy);
    font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.25; letter-spacing: -0.02em; max-width: 26ch;
  }
  .statement__text em { font-style: normal; background: var(--yellow); padding: 0 0.15em; border-radius: 4px; }
  .statement__side p { color: var(--muted); font-size: 1.08rem; margin-bottom: 20px; }

  .stats { list-style: none; margin: clamp(40px, 6vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .stats li { padding: 24px 22px; border-radius: var(--radius); background: var(--bg-soft); display: grid; gap: 8px; }
  .stats li:first-child { background: var(--yellow); }
  .stats li:nth-child(3) { background: var(--navy); }
  .stats li:nth-child(3) strong { color: #fff; }
  .stats li:nth-child(3) span { color: #c8ccd6; }
  .stats strong { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 0.95; color: var(--navy); }
  .stats span { font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .stats li:first-child span { color: var(--navy); }

  @media (max-width: 860px) {
    .statement__grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
