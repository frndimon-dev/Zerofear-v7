---
import Icon from '../Icon.astro';
import { site } from '../../data/site';
---
<section class="section about">
  <div class="container about__grid">
    <div>
      <span class="eyebrow">About Zero Fear</span>
      <h2>We don’t just teach riding. We build the <mark>confidence</mark> to ride on your own.</h2>
    </div>
    <div class="about__side">
      <p>A learner-first school built on years of hands-on training in Kolkata. Structured practice, patient trainers, and confidence before speed.</p>
      <ul class="about__checks">
        <li><Icon name="check" /> No cycling required</li>
        <li><Icon name="check" /> Trainer beside you, every class</li>
        <li><Icon name="check" /> Practice ground → real Kolkata traffic</li>
      </ul>
      <a class="about__more" href="/about">Our story <Icon name="arrow" /></a>
    </div>
  </div>

  <div class="container">
    <ul class="stats">
      {site.stats.map((s) => (
        <li><strong>{s.value}</strong><span>{s.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about__grid { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: clamp(32px, 6vw, 80px); align-items: end; }
  .about__side p { color: var(--muted); font-size: 1.08rem; }
  .about__checks { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; font-weight: 600; }
  .about__checks li { display: flex; gap: 10px; align-items: center; }
  .about__checks :global(svg) { width: 18px; height: 18px; color: var(--success); flex: none; }
  .about__more { display: inline-flex; align-items: center; gap: 6px; margin-top: 22px; font-weight: 700; color: var(--blue); text-decoration: none; }
  .about__more :global(svg) { width: 16px; height: 16px; }

  .stats { list-style: none; margin: clamp(48px, 7vw, 80px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 2px solid var(--navy); }
  .stats li { padding: 28px 16px 0 0; display: grid; gap: 4px; }
  .stats li + li { padding-left: 24px; border-left: 1px solid var(--border); }
  .stats strong { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1; letter-spacing: -0.04em; color: var(--navy); }
  .stats span { color: var(--muted); font-weight: 500; }

  @media (max-width: 860px) {
    .about__grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats li { padding: 22px 12px 18px 0; }
    .stats li + li { padding-left: 0; border-left: 0; }
    .stats li:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--border); }
  }
</style>
