---
import Icon from '../Icon.astro';
import { site } from '../../data/site';
---
<section class="section about">
  <div class="container about__grid">
    <div class="about__copy" data-reveal>
      <span class="eyebrow">About Zero Fear</span>
      <h2 class="about__title">
        Never rode a cycle?<br />
        We’ll get you riding Kolkata roads <em>on your own.</em>
      </h2>
      <p class="about__lead">Patient trainers, one learner at a time. Practice ground first, real traffic only when you’re ready.</p>
      <a class="btn btn--dark btn--lg" href="/about">Our story <Icon name="arrow" /></a>
    </div>

    <div class="about__media" data-reveal>
      <img src="/images/hero-trainer-guiding.webp" alt="Zero Fear trainer guiding a beginner on her scooty" loading="lazy" decoding="async" />
      <div class="about__badge">
        <strong>{site.stats[2].value}</strong>
        <span>beginners now ride on their own</span>
      </div>
    </div>
  </div>

  <div class="container">
    <ul class="stats" data-reveal>
      {site.stats.map((s) => (
        <li><strong>{s.value}</strong><span>{s.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about { background: #fbf8f1; }
  .about__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }

  .about__title {
    font-family: var(--font-serif); font-weight: 600; text-transform: none; letter-spacing: -0.02em;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem); line-height: 1.08; color: var(--navy);
  }
  .about__title em {
    font-style: italic; color: var(--navy);
    background: linear-gradient(transparent 62%, var(--yellow) 62%, var(--yellow) 92%, transparent 92%);
    padding: 0 0.06em;
  }
  .about__lead { margin: 22px 0 28px; color: var(--muted); font-size: 1.12rem; max-width: 44ch; }

  .about__media { position: relative; aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; transform: rotate(1.5deg); box-shadow: 0 30px 60px rgba(12,15,22,.18); }
  .about__media img { width: 100%; height: 100%; object-fit: cover; }
  .about__badge {
    position: absolute; left: 16px; bottom: 16px; right: 16px; padding: 14px 18px; border-radius: 18px;
    background: var(--yellow); color: var(--navy); display: flex; align-items: center; gap: 12px; transform: rotate(-1.5deg);
  }
  .about__badge strong { font-family: var(--font-display); font-weight: 400; font-size: 2.2rem; line-height: 1; }
  .about__badge span { font-weight: 700; line-height: 1.25; }

  .stats { list-style: none; margin: clamp(48px, 7vw, 80px) 0 0; padding: 22px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 2px solid var(--navy); }
  .stats li { display: grid; gap: 4px; padding-right: 12px; }
  .stats strong { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.2rem, 4vw, 3.4rem); line-height: 1; color: var(--navy); }
  .stats span { font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }

  @media (max-width: 860px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__media { aspect-ratio: 4 / 3.6; transform: none; }
    .about__badge { transform: none; }
    .stats { grid-template-columns: repeat(2, 1fr); row-gap: 22px; }
  }
</style>
