---
import { ticker } from '../../data/site';
const items = [...ticker, ...ticker];
---
<div class="ticker" aria-label={ticker.join(', ')}>
  <ul class="ticker__track" aria-hidden="true">
    {items.map((t) => <li>{t}</li>)}
  </ul>
</div>

<style>
  .ticker { background: var(--yellow); color: var(--navy); overflow: hidden; border-block: 2px solid var(--navy); }
  .ticker__track {
    list-style: none; margin: 0; padding: 14px 0;
    display: flex; width: max-content;
    animation: ticker 32s linear infinite;
  }
  .ticker li {
    font-family: var(--font-display); font-weight: 400; font-size: clamp(1.05rem, 2vw, 1.4rem);
    letter-spacing: -0.01em; text-transform: uppercase; white-space: nowrap;
    padding-inline: 22px; display: flex; align-items: center; gap: 44px;
  }
  .ticker li::after { content: '✦'; font-size: 0.8em; }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker__track { animation: none; } }
</style>
