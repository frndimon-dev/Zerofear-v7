---
import Icon from '../Icon.astro';
import { womenPoints } from '../../data/site';
---
<section class="section women" id="women">
  <div class="container women__grid">
    <div class="women__photos">
      <img class="women__main" src="/images/bike-clutch-practice.webp" alt="Woman learning clutch control on a motorcycle with her trainer" loading="lazy" decoding="async" />
      <img class="women__small" src="/images/gallery-family-support.webp" alt="Older learner on a scooty while her family watches" loading="lazy" decoding="async" />
      <span class="women__badge"><strong>Most</strong> of our learners are women</span>
    </div>
    <div>
      <span class="eyebrow">For women riders</span>
      <h2>Confidence changes <mark>everything.</mark></h2>
      <p class="women__lead">Work, college, the market, your child’s school. Riding means going where you need to, without waiting for anyone.</p>
      <ul class="women__points">
        {womenPoints.map((p, i) => (
          <li>
            <span class="women__num">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{p.title}</h3><p>{p.text}</p></div>
          </li>
        ))}
      </ul>
      <a class="btn btn--dark btn--lg" href="/women-riders">For women riders <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .women { background: #fff6f0; }
  .women__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 96px); align-items: center; }
  .women__photos { position: relative; padding: 0 12% 14% 0; }
  .women__main { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-lg); }
  .women__small {
    position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 1; object-fit: cover;
    border-radius: var(--radius); border: 6px solid #fff6f0;
  }
  .women__badge {
    position: absolute; left: 16px; top: 16px; padding: 10px 14px; border-radius: 12px;
    background: var(--yellow); font-weight: 600; font-size: 0.9rem; box-shadow: var(--shadow);
  }
  .women__badge strong { font-family: var(--font-display); font-weight: 800; }
  .women__lead { margin-top: 16px; color: var(--muted); font-size: 1.08rem; max-width: 46ch; }
  .women__points { list-style: none; padding: 0; margin: 28px 0 32px; display: grid; gap: 18px; }
  .women__points li { display: flex; gap: 16px; align-items: flex-start; }
  .women__num { font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; color: #e8743b; line-height: 1; min-width: 40px; }
  .women__points h3 { font-size: 1.15rem; }
  .women__points p { margin-top: 4px; color: var(--muted); }
  @media (max-width: 860px) { .women__grid { grid-template-columns: 1fr; } }
</style>
