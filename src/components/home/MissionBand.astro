---
import { site } from '../../data/site';
const steps = ['Learn', 'Practice', 'Experience', 'Freedom'];
---
<section class="mission" aria-label="Our mission">
  <div class="container">
    <p class="mission__bn" lang="bn">নিজের প্রয়োজনে, নিজের মতো করে চলার স্বাধীনতা।</p>
    <p class="mission__big">{site.tagline}</p>
    <ol class="mission__steps">
      {steps.map((s, i) => <li><span>0{i + 1}</span>{s}</li>)}
    </ol>
  </div>
</section>

<style>
  .mission { background: var(--yellow); color: var(--navy); padding-block: clamp(56px, 8vw, 96px); text-align: center; }
  .mission__bn { font-size: clamp(1.05rem, 2vw, 1.3rem); font-weight: 600; }
  .mission__big {
    margin-top: 10px; font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(3.6rem, 13vw, 12rem); line-height: 0.85; letter-spacing: 0;
  }
  .mission__steps { list-style: none; padding: 0; margin: 32px 0 0; display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; }
  .mission__steps li {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 999px;
    background: var(--navy); color: #fff; font-weight: 700;
  }
  .mission__steps span { color: var(--yellow); font-family: var(--font-display); font-weight: 400; }
</style>
