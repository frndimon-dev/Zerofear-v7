---
// Before & after: the same learner early in the course and after balance came.
// Photos, days and lines are editable in the admin panel (section "progress").
import CmsImg from '../CmsImg.astro';
import Icon from '../Icon.astro';
import { text as t, photo } from '../../cms';
const learners = [1, 2, 3].map((i) => ({
  before: photo(`progress.p${i}a`),
  after: photo(`progress.p${i}b`),
  d1: t(`progress.l${i}d1`).plain,
  d2: t(`progress.l${i}d2`).plain,
  from: t(`progress.l${i}from`).plain,
  to: t(`progress.l${i}to`).plain,
}));
---
<section class="section progress" id="progress">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" set:html={t('progress.eyebrow').html} />
      <h2 set:html={t('progress.title').html} />
      <p set:html={t('progress.lead').html} />
    </div>

    <ul class="progress__rail" aria-label="Before and after, three learners">
      {learners.map((l) => (
        <li class="progress__card" data-reveal>
          <div class="progress__pair">
            <figure class="progress__ph progress__ph--before">
              <CmsImg photo={l.before} sizes="(max-width: 760px) 42vw, 190px" />
              <figcaption>{l.d1}</figcaption>
            </figure>
            <figure class="progress__ph progress__ph--after">
              <CmsImg photo={l.after} sizes="(max-width: 760px) 42vw, 190px" />
              <figcaption>{l.d2}</figcaption>
            </figure>
          </div>
          <p class="progress__line"><span class="progress__from">{l.from}</span> <span class="progress__ar" aria-hidden="true">→</span> <span>{l.to}</span></p>
        </li>
      ))}
    </ul>

    <a class="btn btn--primary btn--lg progress__btn" href="/book">{t('progress.button').plain} <Icon name="arrow" /></a>
  </div>
</section>

<style>
  .progress__rail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .progress__card { background: var(--navy); border-radius: var(--radius-lg, 20px); padding: 12px 12px 16px; color: #fff; }
  .progress__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .progress__ph { position: relative; margin: 0; border-radius: 12px; overflow: hidden; aspect-ratio: 4 / 5; background: #1b2030; }
  .progress__ph :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--fd, 50% 50%); display: block; }
  /* The early photo is a little muted so the change reads at a glance */
  .progress__ph--before :global(img) { filter: saturate(0.55) brightness(0.92); }
  .progress__ph figcaption {
    position: absolute; left: 8px; top: 8px; padding: 4px 9px; border-radius: 999px;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
    background: rgba(12, 15, 22, 0.78); color: #fff;
  }
  .progress__ph--after figcaption { background: var(--yellow); color: var(--navy); }
  .progress__line { margin: 14px 4px 0; font-size: 1.02rem; font-weight: 800; line-height: 1.35; }
  .progress__from { color: #9aa1ad; font-weight: 700; }
  .progress__ar { color: var(--yellow); margin-inline: 4px; }
  .progress__btn { margin-top: clamp(24px, 4vw, 36px); }

  /* Phones: one learner at a time, swipe for the next (the next card peeks in) */
  @media (max-width: 760px) {
    .progress__rail {
      display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none;
    }
    .progress__rail::-webkit-scrollbar { display: none; }
    .progress__card { flex: 0 0 86%; scroll-snap-align: center; }
    .progress__ph :global(img) { object-position: var(--fm, var(--fd, 50% 50%)); }
    .progress__btn { width: 100%; justify-content: center; }
  }
</style>
