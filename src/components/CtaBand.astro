---
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';

interface Props { title: string; text: string; bookHref?: string; whatsappText?: string }
const {
  title,
  text,
  bookHref = '/book',
  whatsappText = 'Hi Zero Fear, I want to know about your training.',
} = Astro.props;
---
<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={bookHref}>Book a class <Icon name="arrow" /></a>
      <a class="btn cta__wa" href={waLink(whatsappText)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      <a class="cta__call" href={`tel:${site.phone.tel}`}><Icon name="phone" /> {site.phone.display}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(48px, 7vw, 80px); background: var(--navy); color: #fff; }
  .cta__inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  p { margin-top: 10px; color: #c5d2e6; max-width: 52ch; }
  .cta__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .cta__wa { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .cta__wa:hover { background: rgba(255, 255, 255, 0.18); }
  .cta__call { display: inline-flex; align-items: center; gap: 6px; color: #fff; font-weight: 700; text-decoration: none; padding: 0 8px; }
  .cta__call :global(svg) { width: 17px; height: 17px; }
</style>
