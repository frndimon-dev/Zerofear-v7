---
import CmsImg from './CmsImg.astro';
import { formatDate, type Post } from '../lib/blog';
import { fonts } from '../cms/fonts';

interface Props { post: Post; dark?: boolean }
const { post, dark = false } = Astro.props;
const { title, description, date, category, image, imageAlt, cover, headingFont } = post.data;
const fontStyle = headingFont ? `font-family:${fonts[headingFont].css};font-weight:${fonts[headingFont].weight}` : undefined;
---
<article class:list={['post', { 'post--dark': dark }]}>
  <div class="post__img"><CmsImg photo={cover ?? { src: image, alt: imageAlt }} sizes="(max-width: 860px) 82vw, 360px" /></div>
  <div class="post__meta"><span class="post__cat">{category}</span><time datetime={date.toISOString()}>{formatDate(date)}</time></div>
  <h3 style={fontStyle}><a href={`/blog/${post.id}`}>{title}</a></h3>
  <p>{description}</p>
</article>

<style>
  .post { position: relative; display: flex; flex-direction: column; }
  .post__img { aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; background: var(--border); }
  .post__img :global(img) { transition: transform 0.5s; }
  .post:hover .post__img :global(img) { transform: scale(1.04); }
  .post__meta { display: flex; gap: 12px; align-items: center; margin-top: 16px; font-size: 0.82rem; color: var(--muted); }
  .post__cat { padding: 3px 10px; border-radius: 999px; background: var(--yellow); color: var(--navy); font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.72rem; }
  .post h3 {
    margin-top: 12px; font-family: var(--font-blog); font-weight: var(--font-blog-weight);
    font-size: clamp(1.35rem, 1.9vw, 1.6rem); line-height: 1.08; letter-spacing: -0.025em;
  }
  .post h3 a { text-decoration: none; background: linear-gradient(var(--yellow), var(--yellow)) 0 92% / 0 0.32em no-repeat; transition: background-size 0.35s; }
  .post h3 a::after { content: ''; position: absolute; inset: 0; }
  .post:hover h3 a { background-size: 100% 0.32em; }
  .post p { margin-top: 10px; color: var(--muted); font-size: 0.95rem; }
  .post--dark h3 { color: #fff; }
  .post--dark p, .post--dark .post__meta { color: #c8ccd6; }
</style>
