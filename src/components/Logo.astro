---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--light': light }]} aria-label="Zero Fear home">
  <span class="logo__mark" aria-hidden="true">ZF</span>
  <span class="logo__text">
    <strong>Zero Fear</strong>
    <small>Scooty & Bike Training</small>
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--navy); }
  .logo__mark {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px;
    background: var(--yellow); color: var(--navy); font-weight: 800; font-size: 0.95rem; letter-spacing: -0.03em;
  }
  .logo__text { display: grid; line-height: 1.1; }
  .logo__text strong { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.02em; }
  .logo__text small { font-size: 0.72rem; font-weight: 600; color: var(--muted); }
  .logo--light { color: #fff; }
  .logo--light .logo__text small { color: #a9bad3; }
</style>
