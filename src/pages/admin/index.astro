---
export const prerender = true;
import App from '../../admin/App';
import { fonts, googleFontsHref, type FontKey } from '../../cms/fonts';
import '../../admin/admin.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Zero Fear Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Every font in the library, for the previews -->
    <link href={googleFontsHref(Object.keys(fonts) as FontKey[])} rel="stylesheet" />
  </head>
  <body>
    <App client:only="preact" />
    <noscript>The admin panel needs JavaScript.</noscript>
  </body>
</html>
