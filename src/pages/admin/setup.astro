---
// One-time database setup for the admin panel, made for a phone or tablet:
// copy the SQL with one tap, open the Supabase SQL editor, paste and Run.
// A new admin password is created in the browser (never stored in the code).
export const prerender = true;
import setupSql from '../../../supabase/admin-setup.sql?raw';
---
<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Zero Fear – Admin setup</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      body { margin: 0; background: #f3f2ee; color: #0c0f16; font: 500 18px/1.55 system-ui, -apple-system, 'Segoe UI', sans-serif; }
      main { max-width: 640px; margin: 0 auto; padding: 24px 16px 60px; }
      h1 { font-size: 1.5rem; margin: 0 0 6px; }
      .logo { font: 900 1.6rem/1 Impact, 'Arial Narrow', sans-serif; letter-spacing: .02em; margin-bottom: 18px; }
      .logo span { background: #ffd60a; padding: 0 6px; }
      .step { background: #fff; border-radius: 18px; padding: 18px; margin-top: 16px; }
      .step h2 { font-size: 1.15rem; margin: 0 0 10px; }
      .btn { box-sizing: border-box; display: block; width: 100%; padding: 18px; border: 0; border-radius: 14px; font: inherit; font-weight: 800; font-size: 1.15rem; text-align: center; text-decoration: none; cursor: pointer; background: #ffd60a; color: #0c0f16; }
      .btn--dark { background: #0c0f16; color: #fff; }
      .ok { color: #128c4a; font-weight: 700; margin: 10px 0 0; min-height: 1.5em; }
      .pw { font: 700 1.3rem/1.4 ui-monospace, Menlo, monospace; background: #0c0f16; color: #ffd60a; padding: 12px 14px; border-radius: 12px; word-break: break-all; }
      ol { padding-left: 1.2em; margin: 8px 0 0; }
      li { margin-bottom: 6px; }
      textarea { width: 100%; height: 120px; margin-top: 10px; font: 12px/1.4 ui-monospace, monospace; border-radius: 10px; border: 1px solid #ddd; padding: 8px; box-sizing: border-box; }
      small { color: #555; }
    </style>
  </head>
  <body>
    <main>
      <div class="logo">ZERO <span>FEAR</span></div>
      <h1>Admin panel চালু করুন (একবারই)</h1>
      <p>নিচের ৩টে ধাপ করুন। কিছু টাইপ করতে হবে না।</p>

      <div class="step">
        <h2>আপনার নতুন password (লিখে রাখুন)</h2>
        <div class="pw" data-pw>…</div>
        <small>Email: frndimon@gmail.com</small>
      </div>

      <div class="step">
        <h2>ধাপ ১</h2>
        <button class="btn" type="button" data-copy>📋 লেখাটা কপি করুন</button>
        <p class="ok" data-copied></p>
      </div>

      <div class="step">
        <h2>ধাপ ২</h2>
        <a class="btn btn--dark" href="https://supabase.com/dashboard/project/fhsslykxcwbpzqusouii/sql/new" target="_blank" rel="noopener">Supabase খুলুন ↗</a>
      </div>

      <div class="step">
        <h2>ধাপ ৩ (Supabase-এর ভেতরে)</h2>
        <ol>
          <li>বড় সাদা লেখার জায়গায় আঙুল চেপে ধরে রাখুন → <b>Paste</b> চাপুন।</li>
          <li>নিচে ডানদিকে সবুজ <b>Run</b> বোতাম চাপুন।</li>
          <li>কোনো সতর্কবার্তা এলে <b>Run this query</b> / <b>Confirm</b> চাপুন।</li>
          <li>নিচে <b>Zero Fear admin is ready</b> লেখা এলে কাজ শেষ। এবার Claude-কে “Done” লিখে জানান।</li>
        </ol>
      </div>

      <details class="step">
        <summary>কপি কাজ না করলে: পুরো লেখাটা এখানে</summary>
        <textarea readonly data-sql></textarea>
      </details>
    </main>

    <script define:vars={{ setupSql }}>
      // A fresh password for this setup, kept for this browser tab only.
      let pw = '';
      try { pw = sessionStorage.getItem('zf-setup-pw') || ''; } catch {}
      if (!pw) {
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
        const rnd = crypto.getRandomValues(new Uint32Array(10));
        pw = 'ZeroFear-' + Array.from(rnd, (n) => chars[n % chars.length]).join('');
        try { sessionStorage.setItem('zf-setup-pw', pw); } catch {}
      }
      const sql = setupSql
        + "\n-- Admin password\n"
        + "update auth.users set encrypted_password = extensions.crypt('" + pw + "', extensions.gen_salt('bf')) where email = 'frndimon@gmail.com';\n"
        + "select 'Zero Fear admin is ready' as result;\n";
      document.querySelector('[data-pw]').textContent = pw;
      const area = document.querySelector('[data-sql]');
      area.value = sql;
      const done = document.querySelector('[data-copied]');
      document.querySelector('[data-copy]').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(sql);
        } catch {
          area.closest('details').open = true;
          area.focus();
          area.select();
          document.execCommand('copy');
        }
        done.textContent = '✓ কপি হয়েছে। এবার ধাপ ২ চাপুন।';
      });
    </script>
  </body>
</html>
