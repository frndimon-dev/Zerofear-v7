---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Ticker from '../components/home/Ticker.astro';
import AboutIntro from '../components/home/AboutIntro.astro';
import Courses from '../components/home/Courses.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Women from '../components/home/Women.astro';
import Doorstep from '../components/home/Doorstep.astro';
import PhotoStrip from '../components/home/PhotoStrip.astro';
import Reviews from '../components/home/Reviews.astro';
import Journey from '../components/home/Journey.astro';
import MissionBand from '../components/home/MissionBand.astro';
import Social from '../components/home/Social.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/home/Contact.astro';
---
<Base>
  <Hero />
  <Ticker />
  <AboutIntro />
  <Courses />
  <HowItWorks />
  <Women />
  <PhotoStrip />
  <Doorstep />
  <Reviews />
  <Journey />
  <MissionBand />
  <Social />
  <Faq />
  <Contact />
  <script is:inline>
    // Old single-page site used #hash routes; send those visitors to the new pages.
    (function () {
      var map = {
        'courses/basic-scooty-training': '/courses/basic-scooty-training',
        'courses/advanced-scooty-training': '/courses/advanced-scooty-training',
        'courses/bike-training': '/courses/bike-training',
        'courses/rto-exam-preparation': '/courses/rto-exam-preparation',
        'doorstep-training': '/doorstep-training', 'doorstep': '/doorstep-training', 'doorstep-detail': '/doorstep-training',
        'women-detail': '/women-riders', 'about-detail': '/about', 'mission-detail': '/about',
        'faq-detail': '/faq', 'booking': '/book',
      };
      var target = map[location.hash.slice(1)];
      if (target) location.replace(target);
    })();
  </script>
</Base>
