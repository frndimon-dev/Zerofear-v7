---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title={`Page not found | ${site.name}`}>
  <section class="section not-found">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>This page took a wrong turn.</h1>
      <p>The page you’re looking for doesn’t exist or has moved.</p>
      <div class="actions">
        <a class="btn btn--primary" href="/">Go to home <Icon name="arrow" /></a>
        <a class="btn btn--outline" href="/courses">See courses</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found { text-align: center; min-height: 60vh; display: grid; place-items: center; }
  p { margin-top: 14px; color: var(--muted); font-size: 1.1rem; }
  .actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
</style>
